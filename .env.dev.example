APP_ENV=development
SESSION_COOKIE_SECURE=false

# Use a development database that is separate from production.
DB_NAME=
DB_USERNAME=
DB_PASSWORD=
DB_HOSTNAME=
DB_PORT=5432
DB_SSLMODE=disable
API_TOKEN=
RUST_DB_SSLMODE=disable

# RUST_PORT is passed to the Rust container as PORT
RUST_PORT=8083
RUST_LOG=info

# Use a different Telegram bot token if dev and prod run concurrently.
BOT_API_KEY=
TELEGRAM_ALLOWED_USER_ID=

# Server-side statement extraction key.
GEMINI_API_KEY=
GRAFANA_ADMIN_PASSWORD=admin

# Optional attachment storage in development.
S3_BUCKET=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
