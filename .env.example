# Application environment: production or development
APP_ENV=production
SESSION_COOKIE_SECURE=false

# PostgreSQL connection settings
DB_NAME=
DB_USERNAME=
DB_PASSWORD=
DB_HOSTNAME=
DB_PORT=5432
DB_SSLMODE=require

# Rust backend bearer token. Use a different random value in .env.dev.
API_TOKEN=
RUST_DB_SSLMODE=disable
# RUST_PORT is passed to the Rust container as PORT; 18083 is the host port.
RUST_PORT=8083
RUST_LOG=info

# Telegram bot token from BotFather
BOT_API_KEY=
TELEGRAM_ALLOWED_USER_ID=

# Server-side Gemini key for statement extraction. Never use NEXT_PUBLIC_ here.
GEMINI_API_KEY=

# Required for the locally bound Grafana dashboard.
GRAFANA_ADMIN_PASSWORD=

# Optional private S3 storage for Garage maintenance receipts and service bills.
# Use standard AWS credentials or an IAM role; never expose these values as NEXT_PUBLIC variables.
S3_BUCKET=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Observability Configuration
# LOG_LEVEL=info # debug, info, warn, error (default: info in prod, debug in dev)
# LOG_FORMAT=json # json or text (default: json in prod, text in dev)
# OTEL_SERVICE_NAME=life-backend
# OTEL_SERVICE_VERSION=1.0.0
# OTEL_EXPORTER_OTLP_ENDPOINT= # e.g. localhost:4317 for OpenTelemetry Collector / Jaeger / Tempo
# OTEL_EXPORTER_OTLP_INSECURE=true
# PPROF_ENABLED=false # enable /debug/pprof profiling endpoints
# PPROF_AUTH_USER= # basic auth username for /debug/pprof
# PPROF_AUTH_PASS= # basic auth password for /debug/pprof
