APP_ENV=production
SESSION_COOKIE_SECURE=false

# Hermes MCP
MCP_BACKEND_USERNAME=
MCP_BACKEND_PASSWORD=

# Token for the Rust backend Cloudflare Tunnel
CLOUDFLARE_TUNNEL_TOKEN=

# PostgreSQL connection settings
DB_NAME=
DB_USERNAME=
DB_PASSWORD=
DB_HOSTNAME=
DB_PORT=5432
DB_SSLMODE=require
RUST_DB_SSLMODE=disable

# RUST_PORT is passed to the Rust container as PORT.
RUST_PORT=8083
RUST_LOG=info

# Gemini key for statement extraction.
GEMINI_API_KEY=

# Grafana dashboard.
GRAFANA_ADMIN_PASSWORD=
# Set to the Docker host's Tailscale IPv4 address for access over Tailscale.
GRAFANA_BIND_ADDRESS=127.0.0.1

# Optional private S3 storage 
S3_BUCKET=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Observability Configuration
# LOG_LEVEL=info # debug, info, warn, error (default: info in prod, debug in dev)
# LOG_FORMAT=json # json or text (default: json in prod, text in dev)
# OTEL_SERVICE_NAME=life-backend
# OTEL_SERVICE_VERSION=1.0.0
# OTEL_EXPORTER_OTLP_ENDPOINT= # e.g. localhost:4317 for OpenTelemetry Collector / Jaeger / Tempo
# OTEL_EXPORTER_OTLP_INSECURE=true
# PPROF_ENABLED=false # enable /debug/pprof profiling endpoints
# PPROF_AUTH_USER= # basic auth username for /debug/pprof
# PPROF_AUTH_PASS= # basic auth password for /debug/pprof
