# Application environment: production or development
APP_ENV=production

# PostgreSQL connection settings
DB_NAME=
DB_USERNAME=
DB_PASSWORD=
DB_HOSTNAME=
DB_PORT=5432
DB_SSLMODE=require

# Telegram bot token from BotFather
BOT_API_KEY=

# Gemini key used by the browser for statement extraction. Restrict it by origin/API.
NEXT_PUBLIC_GEMINI_API_KEY=

# Optional private S3 storage for Garage maintenance receipts and service bills.
# Use standard AWS credentials or an IAM role; never expose these values as NEXT_PUBLIC variables.
S3_BUCKET=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN= # only needed for temporary credentials
# S3_ENDPOINT= # optional: S3-compatible endpoint such as MinIO
# S3_FORCE_PATH_STYLE=true # optional: normally only needed for S3-compatible storage
