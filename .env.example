# Application environment: production or development
APP_ENV=production

# PostgreSQL connection settings
DB_NAME=
DB_USERNAME=
DB_PASSWORD=
DB_HOSTNAME=
DB_PORT=5432
DB_SSLMODE=require

# Telegram bot token from BotFather
BOT_API_KEY=

# Gemini key used by the browser for statement extraction. Restrict it by origin/API.
NEXT_PUBLIC_GEMINI_API_KEY=

# Optional private S3 storage for Garage maintenance receipts and service bills.
# Use standard AWS credentials or an IAM role; never expose these values as NEXT_PUBLIC variables.
S3_BUCKET=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN= # only needed for temporary credentials
# S3_ENDPOINT= # optional: S3-compatible endpoint such as MinIO
# S3_FORCE_PATH_STYLE=true # optional: normally only needed for S3-compatible storage

# Observability Configuration
# LOG_LEVEL=info # debug, info, warn, error (default: info in prod, debug in dev)
# LOG_FORMAT=json # json or text (default: json in prod, text in dev)
# OTEL_SERVICE_NAME=life-backend
# OTEL_SERVICE_VERSION=1.0.0
# OTEL_EXPORTER_OTLP_ENDPOINT= # e.g. localhost:4317 for OpenTelemetry Collector / Jaeger / Tempo
# OTEL_EXPORTER_OTLP_INSECURE=true
# PPROF_ENABLED=false # enable /debug/pprof profiling endpoints
# PPROF_AUTH_USER= # basic auth username for /debug/pprof
# PPROF_AUTH_PASS= # basic auth password for /debug/pprof

