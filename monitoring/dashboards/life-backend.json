  "refresh": "10s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": [
    "life-backend",
    "observability",
    "golden-signals"
  ],
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "title": "PULSE Backend - Observability & Golden Signals",
  "uid": "life-backend-overview",
  "templating": {
    "list": [
      {
        "name": "backend",
        "label": "Backend",
        "type": "query",
        "datasource": "Prometheus",
        "query": "label_values(up{job=~\"life-backend|rust-backend\"}, service)",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  }
}
