{
  "uid": "service-logs",
  "_comment": "ponytail: Grafana doublequote escapes quotes but not backslashes; use a Loki-aware formatter if literal path searches are needed.",
  "title": "Service Logs",
  "description": "Container stdout/stderr for this Compose project. Select services and search text; open the panel in Explore and click Live for streaming.",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "tags": [
    "logs"
  ],
  "timezone": "browser",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "5s",
  "links": [
    {
      "title": "Live logs / Explore",
      "type": "link",
      "url": "/explore",
      "targetBlank": false
    }
  ],
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Services",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "query": "label_values(service)",
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "options": []
      },
      {
        "name": "search",
        "label": "Search text",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        },
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Logs",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 22,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service=~\"${service:regex}\"} |= ${search:doublequote}",
          "queryType": "range",
          "editorMode": "code",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": true,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      }
    }
  ]
}
